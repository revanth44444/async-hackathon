# Get a free key at https://console.groq.com/keys. Without it, extraction falls back to keyword parsing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL (docker compose up -d db). Leave unset to use a local SQLite file.
DATABASE_URL=postgresql://offerlens:offerlens@localhost:5432/offerlens

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
